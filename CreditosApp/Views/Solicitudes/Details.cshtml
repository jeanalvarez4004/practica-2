@model CreditosApp.Models.SolicitudCredito
@{
    ViewData["Title"] = $"Solicitud #{Model.Id}";
}

<h1>Solicitud #@Model.Id</h1>

@if (TempData["Exito"] is string exito)
{
    <div class="alert alert-success">@exito</div>
}
@if (TempData["AvisoCola"] is string aviso)
{
    <div class="alert alert-warning">
        @aviso
        <form asp-action="ReenviarNotificacion" method="post" class="mt-2">
            <input type="hidden" name="id" value="@Model.Id" />
            <button class="btn btn-sm btn-warning" type="submit">Reenviar notificación</button>
        </form>
    </div>
}
@if (TempData["Error"] is string terror)
{
    <div class="alert alert-danger">@terror</div>
}

<dl class="row">
    <dt class="col-sm-3">Monto solicitado</dt>
    <dd class="col-sm-9">S/ @Model.MontoSolicitado.ToString("N2")</dd>
    <dt class="col-sm-3">Fecha</dt>
    <dd class="col-sm-9">@Model.FechaSolicitud.ToLocalTime().ToString("f")</dd>
    <dt class="col-sm-3">Estado</dt>
    <dd class="col-sm-9"><span data-estado-id="@Model.Id">@Model.Estado</span> <partial name="_Realtime" /></dd>
    @if (!string.IsNullOrEmpty(Model.MotivoRechazo))
    {
        <dt class="col-sm-3">Motivo de rechazo</dt>
        <dd class="col-sm-9"><span data-motivo-id="@Model.Id">@Model.MotivoRechazo</span></dd>
    }
</dl>

<a asp-action="Index" class="btn btn-secondary">Volver a mis solicitudes</a>
